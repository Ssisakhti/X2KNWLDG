              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "IndexUnavailable": {
        "description": "The index is absent, building, or in error, so no honest answer can be given yet (`index_unavailable`).",
        "content": {
          "application/json": {
