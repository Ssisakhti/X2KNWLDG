      "SearchHitKnowledgeUnit": {
        "description": "A knowledge-unit hit, field for field as `query.search_knowledge` returns it, plus `global_id` and `source_id`. The canonical field names are kept — `video_id` stays `video_id` (ADR 0001 invariant 6) and `id` stays the canonical unit id — so the shape the MCP tools and the CLI already return is the shape the API returns.",
        "type": "object",
        "required": [
          "type",
          "video_id",
          "title",
          "id",
          "kind",
          "source_class",
          "content",
          "confidence",
          "global_id",
          "source_id"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "const": "knowledge_unit"
          },
          "video_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "description": "The canonical knowledge unit id, e.g. `KU-000001`.",
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_class": {
            "type": [
              "string",
              "null"
            ]
          },
          "content": {
            "type": [
              "string",
              "null"
            ]
          },
          "confidence": {
            "type": [
              "number",
              "null"
            ]
          },
          "start_sec": {
            "description": "Present only when the canonical unit states a numeric start. Absent, not zero, when it does not.",
            "$ref": "../../v1/common.schema.json#/$defs/timestampSec"
          },
          "source_url": {
            "description": "Deep link built by `io.timestamp_url`. Present only alongside `start_sec`.",
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "derived_from": {
            "description": "Present only for a derived-class unit, in the canonical id form the unit itself carries.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "global_id": {
            "description": "Additive. Null when the canonical data cannot form one — a run whose metadata states no `video_id` has no addressable entity, and a fabricated id would be worse than none.",
            "oneOf": [
              {
                "$ref": "../../v1/common.schema.json#/$defs/globalId"
              },
              {
                "type": "null"
              }
            ]
          },
          "source_id": {
            "description": "Additive.",
            "oneOf": [
              {
                "$ref": "../../v1/common.schema.json#/$defs/sourceId"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "SearchHitTranscriptCaption": {
        "description": "A transcript-caption hit, field for field as `query.search_knowledge` returns it, plus `source_id`. It carries no `global_id`: v1 emits no caption entities (D-023), so there is no entity to address. The client navigates by source and timestamp instead.",
        "type": "object",
        "required": [
          "type",
          "video_id",
          "title",
          "caption_id",
          "content",
          "start_sec",
          "end_sec",
          "source_url",
          "source_id"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "const": "transcript_caption"
          },
          "video_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "caption_id": {
            "description": "The canonical caption's `segment_id`.",
            "type": [
              "string",
              "null"
            ]
          },
          "content": {
            "type": [
              "string",
              "null"
            ]
          },
          "start_sec": {
            "$ref": "../../v1/common.schema.json#/$defs/timestampSec"
          },
          "end_sec": {
            "oneOf": [
              {
                "$ref": "../../v1/common.schema.json#/$defs/timestampSec"
              },
              {
                "type": "null"
              }
            ]
          },
          "source_url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "source_id": {
            "oneOf": [
              {
                "$ref": "../../v1/common.schema.json#/$defs/sourceId"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "SearchHit": {
        "description": "One result. `type` is the discriminator.",
        "oneOf": [
          {
            "$ref": "#/components/schemas/SearchHitKnowledgeUnit"
          },
          {
            "$ref": "#/components/schemas/SearchHitTranscriptCaption"
          }
        ],
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "knowledge_unit": "#/components/schemas/SearchHitKnowledgeUnit",
            "transcript_caption": "#/components/schemas/SearchHitTranscriptCaption"
          }
        }
      },
