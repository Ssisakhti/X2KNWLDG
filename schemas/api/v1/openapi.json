            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "NotFound": {
        "description": "The id is well-formed but names nothing (`not_found`), or names an artifact whose file is absent (`unavailable`).",
        "content": {
          "application/json": {
