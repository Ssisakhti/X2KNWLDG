# youtube-to-knowledge: personal vault data.
# Ignore the contents, not the directories: `vault/content/` as a directory pattern
# also ignored `vault/content/.gitkeep`, so the placeholder that exists to make the
# directory survive a clone was itself never committed. Match the children and
# re-include the placeholders instead.
vault/content/*
!vault/content/.gitkeep
vault/graphs/*
!vault/graphs/.gitkeep
vault/processed_videos.md

# Runtime inputs, immutable evidence, and generated knowledge outputs
# Keep these local; they may contain copyrighted or private source material.
inbox/
output/

# Audio/video temp files (yt-dlp downloads)
*.m4a
*.mp3
*.webm
*.mp4
*.mkv

# PyVis output (regenerated locally)
vault/**/*.html

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Machine-local configuration
config/*.local.json

# Rebuildable local UI/index cache
.x2knwldg/

# Frontend toolchain (T-008). web/package-lock.json IS committed, so `npm ci`
# and CI install the same tree.
node_modules/
.vite/
*.tsbuildinfo

# The browser gate's own output (T-209): traces, screenshots and reports for a
# run that has already been read. The specs are committed; what one run of them
# produced is not.
web/test-results/
web/playwright-report/
web/blob-report/

# The T-211 mockup captures. Same rule as the browser gate above: the sources
# are committed -- the mockup pages, their stylesheet, the extracted records and
# the layout -- and what one run of them rendered is not. `capture_mockups.ts`
# reproduces every PNG from those sources, so committing them would store a
# render that can drift from its own source with nothing to notice. The approved
# compositions also live, permanently, in the published review artifact.
docs/mockups/*/captures/

# The T-215 review page, for the same reason one line up: `review_sheet.ts`
# builds it out of the two capture sets, and a committed copy would point at
# pictures a clone does not have.
docs/mockups/*/review.html
