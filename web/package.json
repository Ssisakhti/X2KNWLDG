{
  "name": "x2knwldg-web",
  "private": true,
  "version": "0.1.0",
  "description": "Local Knowledge Canvas frontend: Vite + React + TypeScript over the frozen read-only API.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "../.venv/bin/python scripts/dev_api.py",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "browser": "playwright test",
    "typecheck:browser": "tsc --noEmit --project browser/tsconfig.json",
    "typecheck:scripts": "tsc --noEmit --project scripts/tsconfig.json",
    "mockups:layout": "tsx scripts/mockup_layout.ts",
    "mockups:capture": "tsx scripts/capture_mockups.ts",
    "mockups:review": "tsx scripts/review_sheet.ts",
    "mockups:baseline": "tsx scripts/capture_baseline.ts",
    "measure:orbit": "tsx scripts/measure_orbit.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.62.1",
    "@testing-library/react": "^16.3.3",
    "@types/events": "3.0.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "graphology": "0.26.0",
    "graphology-layout-forceatlas2": "0.10.1",
    "graphology-types": "0.24.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "sigma": "4.0.0-beta.5"
  }
}
